<?xml version="1.0"?>
<robot name="box" xmlns:xacro="http://ros.org/wiki/xacro">
    <link name="base_link">
        <visual>
            <geometry>
                <box size="1 1 0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </visual>
    </link>
    <material name="blue">
        <color rgba="0 0 1 1"/>
    </material>
    <link name="top_link">
        <visual>
            <geometry>
                <box size="1 1 0.05"/>
            </geometry>
            <origin xyz="0.5 0 0" rpy="0 0 0"/>
            <material name="blue"/>
        </visual>
    </link>
    <joint name="top_to_back" type="revolute">
        <axis rpy="0 0 0" xyz="0 -1 0"/>
        <parent link="back_link"/>
        <child link="top_link"/>
        <limit effort="1000.0" lower="0" upper="1.57" velocity="0.5"/>
        <origin xyz="0 0 1" rpy="0 0 0"/>
    </joint>
    <link name="right_link">
        <visual>
            <geometry>
                <box size="1 1 0.05"/>
            </geometry>
            <origin xyz="0 0 0.5" rpy="${pi/2} 0 0"/>
        </visual>
    </link>
    <joint name="right_to_bottom" type="fixed">
        <parent link="base_link"/>
        <child link="right_link"/>
        <origin xyz="0 .5 0" rpy="0 0 0"/>
    </joint>
    <link name="left_link">
        <visual>
            <geometry>
                <box size="1 1 0.05"/>
            </geometry>
            <origin xyz="0 0 0.5" rpy="${pi/2} 0 0"/>
        </visual>
    </link>
    <joint name="left_to_bottom" type="fixed">
        <parent link="base_link"/>
        <child link="left_link"/>
        <origin xyz="0 -0.5 0" rpy="0 0 0"/>
    </joint>
    <link name="front_link">
        <visual>
            <geometry>
                <box size="1 1 0.05"/>
            </geometry>
            <origin xyz="0 0 0.5" rpy="${pi/2} 0 ${pi/2}"/>
        </visual>
    </link>
    <joint name="front_to_bottom" type="fixed">
        <parent link="base_link"/>
        <child link="front_link"/>
        <origin xyz="0.5 0 0" rpy="0 0 0"/>
    </joint>
    <link name="back_link">
        <visual>
            <geometry>
                <box size="1 1 0.05"/>
            </geometry>
            <origin xyz="0 0 0.5" rpy="${pi/2} 0 ${pi/2}"/>
        </visual>
    </link>
    <joint name="back_to_bottom" type="fixed">
        <parent link="base_link"/>
        <child link="back_link" />
        <origin xyz="-0.5 0 0" rpy="0 0 0"/>
    </joint>
    <link name="bottom_cylinder">
        <visual>
            <geometry>
                <cylinder length="0.5" radius="0.25"/>
            </geometry>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
        </visual>
    </link>
    <joint name="bottom_cylinder_to_bottom" type="fixed">
        <parent link="base_link"/>
        <child link="bottom_cylinder"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="top_cylinder">
        <visual>
            <geometry>
                <cylinder length="0.5" radius="0.125"/>
            </geometry>
            <origin xyz="0 0 0.25" rpy="0 0 0"/>
        </visual>
    </link>
    <joint name="cylinder_joint" type="prismatic">
        <axis rpy="0 0 0" xyz="0 0 1"/>
        <parent link="bottom_cylinder"/>
        <child link="top_cylinder"/>
        <limit effort="1000.0" lower="0" upper="0.5" velocity="0.5"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="sphere">
        <visual>
            <geometry>
                <sphere radius="0.25"/>
            </geometry>
            <origin xyz="0 0 0.75" rpy="0 0 0"/>
        </visual>
    </link>
    <joint name="sphere_to_top_cylinder" type="fixed">
        <parent link="top_cylinder"/>
        <child link="sphere"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
</robot>
