<?xml version="1.0"?>
<package format="3">
  <name>turtle_interfaces</name>
  <version>0.0.0</version>
  <description>Interfaces for python_turtle</description>
  <maintainer email="emma@example.com">Emma</maintainer>
  <license>BSD-2-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Interface generation -->
  <build_depend>rosidl_default_generators</build_depend>
  <build_export_depend>rosidl_default_generators</build_export_depend>

  <!-- Message dependency -->
  <depend>geometry_msgs</depend>

  <!-- Runtime for generated interfaces -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>
</package>
